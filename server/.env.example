# ===================================
# PetCo Backend Environment Variables
# ===================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,exp://localhost:8081

# PostgreSQL Database Connection URL (Prisma)
# Replace with your local PostgreSQL or cloud PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/petco?schema=public"

# Authentication / JWT Secrets
JWT_SECRET="petco_super_secure_access_token_secret_key_change_in_production"
JWT_REFRESH_SECRET="petco_super_secure_refresh_token_secret_key_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Map Provider API Key (Google Maps, Mapbox, or OpenStreetMap abstraction)
MAPS_API_KEY=""

# Cloud Media Storage (Cloudinary - optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Push Notification Settings
PUSH_NOTIFICATION_CONFIG=""
